# MavunoPay environment variables example
# Copy to .env or set in Vercel project settings

# General
NODE_ENV=production
PORT=3000

# Stellar / Soroban
STELLAR_NETWORK=TESTNET
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
SOROBAN_CONTRACT_ID=

# Key vault (local/hashicorp/aws)
KEY_VAULT_PROVIDER=local
KEY_VAULT_ENDPOINT=
KEY_VAULT_TOKEN=

# Optional USDC token config
USDC_ISSUER=
USDC_CODE=USDC

# Database (use Supabase or local JSON DB)
USE_SUPABASE=false
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS (optional, for OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: when frontend is deployed separately, point VITE_BACKEND_URL to backend URL
VITE_BACKEND_URL=
