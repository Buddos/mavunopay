{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "VERCEL=1 npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/[...].js": {
      "runtime": "nodejs22.x",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ],
  "env": {
    "VERCEL": "1"
  }
}
