{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260429-beta"
  },
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ],
  "functions": {
    "*.mjs": {
      "runtime": "nodejs22.x",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}