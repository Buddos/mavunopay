# MavunoPay Backend Environment Variables

# Stellar Configuration
STELLAR_NETWORK=TESTNET
# STELLAR_NETWORK=PUBLIC

# Key Vault Configuration (for securing Stellar secrets)
# Options: aws | hashicorp | local
KEY_VAULT_PROVIDER=local
# KEY_VAULT_PROVIDER=aws
# KEY_VAULT_ENDPOINT=https://secrets.us-east-1.amazonaws.com
# KEY_VAULT_TOKEN=your-aws-or-vault-token
# AWS_REGION=us-east-1

# For local vault (development only)
# Secrets stored in environment variables with format: STELLAR_SECRET_{farmerId}

# USDC/Stablecoin Configuration
# Optional - if set, trustline will be auto-created
# USDC_CODE=USDC
# USDC_ISSUER=GBUQWP3BOUZX34ULNQG23RQ6F4BVWBRZ4Z5QJSTEVVU5KS7LZLFORMS

# Soroban Contract Configuration
# SOROBAN_CONTRACT_ID=CDTEZY73O47FREBTUDDFTBTINS7ZI2FTW37XGTISP22HEK3DGA5DA67Y
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org:443
# FEE_BUMP_SPONSOR_SECRET=SXXXXXXXXXXXXXXX
# PAYMENT_STREAM_ENABLED=true
# MONITORED_PUBLIC_KEYS=GABCDE... , GFGHIJ...
# This contract ID is obtained after deploying the contract to Stellar testnet/mainnet

# Server Configuration
PORT=3001
NODE_ENV=development

# Comma-separated frontend origins allowed for cross-origin API requests
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database — copy from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Use the "Session pooler" URI for Vercel/serverless (IPv4-friendly). Encode @ in passwords as %40.
# Project region: eu-central-1 (aws-1)
DATABASE_URL=postgresql://postgres.llebclfooyrcjrqewzdl:YOUR_DB_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://llebclfooyrcjrqewzdl.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Twilio SMS configuration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# API Endpoint for incoming harvest notifications
WEBHOOK_SECRET=
