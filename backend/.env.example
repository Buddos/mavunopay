# MavunoPay Backend Environment Variables

# Stellar Configuration
STELLAR_NETWORK=TESTNET
# STELLAR_NETWORK=PUBLIC

# Key Vault Configuration (for securing Stellar secrets)
# Options: aws | hashicorp | local
KEY_VAULT_PROVIDER=local
# KEY_VAULT_PROVIDER=aws
# KEY_VAULT_ENDPOINT=https://secrets.us-east-1.amazonaws.com
# KEY_VAULT_TOKEN=your-aws-or-vault-token
# AWS_REGION=us-east-1

# For local vault (development only)
# Secrets stored in environment variables with format: STELLAR_SECRET_{farmerId}

# USDC/Stablecoin Configuration
# Optional - if set, trustline will be auto-created
# USDC_CODE=USDC
# USDC_ISSUER=GBUQWP3BOUZX34ULNQG23RQ6F4BVWBRZ4Z5QJSTEVVU5KS7LZLFORMS

# Soroban Contract Configuration
# SOROBAN_CONTRACT_ID=CDTEZY73O47FREBTUDDFTBTINS7ZI2FTW37XGTISP22HEK3DGA5DA67Y
# This contract ID is obtained after deploying the contract to Stellar testnet/mainnet

# Server Configuration
PORT=3001
NODE_ENV=development

# Database (when migrating from file-based to Supabase)
# Use a properly encoded URL when your password contains characters such as @
# Example: postgres://postgres:Winnerbonnie%402004@db.llebclfooyrcjrqewzdl.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD%40HOST@db.llebclfooyrcjrqewzdl.supabase.co:5432/postgres
SUPABASE_URL=https://db.llebclfooyrcjrqewzdl.supabase.co
SUPABASE_KEY=sb_publishable_zmIb6J9PKI7y6E5-SlfEwg_GDq04P_6

# API Endpoint for incoming harvest notifications
WEBHOOK_SECRET=
